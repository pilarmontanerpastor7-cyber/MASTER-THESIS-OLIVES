8. EXTRAER VALORES POR FASE DE FORMA RAPIDA

=========================

Esta funcion NO crea una tabla mensual enorme.

Para cada variable y fase devuelve una matriz:

filas = celdas/puntos; columnas = años.

extraer_matriz_fase <- function(files, varname, fase_name, months, points_sf, jaen_sf, agg = c("mean", "sum")) {agg <- match.arg(agg)years <- sapply(files, get_year_from_name)keep <- !is.na(years)files <- files[keep]years <- years[keep]

ord <- order(years)files <- files[ord]years <- years[ord]

mat <- matrix(NA_real_, nrow = nrow(points_sf), ncol = length(files))colnames(mat) <- as.character(years)

for (i in seq_along(files)) {f <- files[i]y <- years[i]message("  ", varname, " | ", fase_name, " | ", y, " (", i, "/", length(files), ")")

r <- tryCatch(terra::rast(f), error = function(e) NULL)
if (is.null(r)) next

r <- corregir_raster_variable(r, varname)

if (terra::nlyr(r) < max(months)) {
  warning("Archivo con menos capas de las esperadas: ", basename(f))
  next
}

r_phase <- r[[months]]

r_phase <- if (agg == "sum") {
  app(r_phase, sum, na.rm = TRUE)
} else {
  app(r_phase, mean, na.rm = TRUE)
}

# Transformar puntos y provincia al CRS del raster.
points_r <- points_sf
jaen_r_sf <- jaen_sf
if (sf::st_crs(points_r)$wkt != terra::crs(r_phase)) {
  points_r <- sf::st_transform(points_r, terra::crs(r_phase))
  jaen_r_sf <- sf::st_transform(jaen_r_sf, terra::crs(r_phase))
}

jaen_r <- terra::vect(jaen_r_sf)
r_phase <- tryCatch({
  terra::crop(r_phase, jaen_r) |> terra::mask(jaen_r)
}, error = function(e) r_phase)

vals <- tryCatch(
  terra::extract(r_phase, terra::vect(points_r))[, 2],
  error = function(e) {
    warning("Error extrayendo ", varname, " ", fase_name, " ", y, ": ", e$message)
    rep(NA_real_, nrow(points_sf))
  }
)

mat[, i] <- vals
gc()

}

list(matrix = mat, years = years)}

cor_por_celda <- function(mat, years, rend_df, response) {common_years <- intersect(as.numeric(colnames(mat)), rend_df$year)if (length(common_years) < 5) {return(data.frame(cell_id = grid_points$cell_id, n = 0, r = NA_real_, p = NA_real_))}

mat2 <- mat[, as.character(common_years), drop = FALSE]y <- rend_df[[response]][match(common_years, rend_df$year)]

calc_one <- function(x) {ok <- complete.cases(x, y)n <- sum(ok)if (n < 5 || sd(x[ok]) == 0 || sd(y[ok]) == 0) {return(c(n = n, r = NA_real_, p = NA_real_))}ct <- suppressWarnings(cor.test(x[ok], y[ok], method = "pearson"))c(n = n, r = unname(ct$estimate), p = ct$p.value)}

res <- t(apply(mat2, 1, calc_one))data.frame(cell_id = grid_points$cell_id,n = res[, "n"],r = res[, "r"],p = res[, "p"])}

