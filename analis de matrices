normalizar_texto <- function(x) {x <- as.character(x)x <- iconv(x, from = "", to = "ASCII//TRANSLIT")tolower(trimws(x))}

limpiar_numerico <- function(x) {x <- as.character(x)x <- trimws(x)x <- gsub("\u00A0", "", x)x <- gsub(" ", "", x)x <- gsub("\.(?=\d{3}(\D|$))", "", x, perl = TRUE)x <- gsub(",", ".", x)x <- gsub("[^0-9\.-]", "", x)suppressWarnings(as.numeric(x))}

