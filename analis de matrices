corregir_raster_variable <- function(r, varname) {test_val <- tryCatch(as.numeric(terra::global(terra::mean(r, na.rm = TRUE), "mean", na.rm = TRUE)[1, 1]),error = function(e) NA_real_)

Temperaturas TerraClimate: a veces vienen en decimas.

if (varname %in% c("TMAX", "TMIN")) {if (!is.na(test_val) && test_val > -5 && test_val < 5) r <- r * 10}

VPD y viento: control flexible de escala.

if (varname == "VPD") {if (!is.na(test_val) && test_val > 20) r <- r / 100else if (!is.na(test_val) && test_val > 10) r <- r / 10}

if (varname == "WSPEED") {if (!is.na(test_val) && test_val > 100) r <- r / 100else if (!is.na(test_val) && test_val > 30) r <- r / 10}

Rangos mensuales plausibles.

if (varname == "PPT")    r[r < 0 | r > 1000] <- NAif (varname == "TMAX")   r[r < -5 | r > 50] <- NAif (varname == "TMIN")   r[r < -20 | r > 35] <- NAif (varname == "PET")    r[r < 0 | r > 500] <- NAif (varname == "PDSI")   r[r < -10 | r > 10] <- NAif (varname == "VPD")    r[r < 0 | r > 10] <- NAif (varname == "WSPEED") r[r < 0 | r > 40] <- NA

r}

