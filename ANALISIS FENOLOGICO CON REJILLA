crear_mapa_correlacion <- function(cor_df, grid_sf, response_name, variable_name, fase_name, file_out) {
  d <- cor_df |>
    filter(
      respuesta == response_name,
      variable == variable_name,
      fase == fase_name
    ) |>
    select(cell_id, r, p)
  
  mapa <- grid_sf |>
    left_join(d, by = "cell_id")
  
  p <- ggplot(mapa) +
    geom_sf(aes(fill = r), color = NA) +
    geom_sf(data = jaen, fill = NA, color = "black", linewidth = 0.25) +
    scale_fill_gradient2(
      low = "#B2182B",
      mid = "white",
      high = "#2166AC",
      midpoint = 0,
      limits = c(-1, 1),
      na.value = "grey90"
    ) +
    labs(
      title = paste(response_name, "-", variable_name, "-", fase_name),
      subtitle = "Correlación de Pearson por celda de 250 m",
      fill = "r"
    ) +
    theme_minimal(base_size = 11) +
    theme(
      plot.title = element_text(face = "bold", hjust = 0.5),
      plot.subtitle = element_text(hjust = 0.5),
      axis.text = element_blank(),
      axis.title = element_blank(),
      panel.grid = element_blank()
    )
  
  ggsave(file_out, p, width = 8, height = 7, dpi = 320)
}

