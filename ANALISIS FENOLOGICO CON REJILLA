plot_heatmap_feno <- function(df, response_name, file_out) {
  d <- df |>
    filter(respuesta == response_name) |>
    mutate(
      fase = factor(fase, levels = orden_fases),
      variable = factor(variable, levels = rev(vars_clima)),
      etiqueta = sprintf("%.2f", r_media)
    )
  
  p <- ggplot(d, aes(x = fase, y = variable, fill = r_media)) +
    geom_tile(color = "white", linewidth = 0.6) +
    geom_text(aes(label = etiqueta), size = 3.4, fontface = "bold") +
    scale_fill_gradient2(
      low = "#B2182B",
      mid = "white",
      high = "#2166AC",
      midpoint = 0,
      limits = c(-1, 1),
      na.value = "grey90"
    ) +
    labs(
      title = paste("Sensibilidad fenológica del rendimiento -", response_name),
      subtitle = "Correlación media provincial por celda de 250 m",
      x = "Fase fenológica",
      y = "Variable climática",
      fill = "r media"
    ) +
    theme_minimal(base_size = 12) +
    theme(
      plot.title = element_text(face = "bold", hjust = 0.5),
      plot.subtitle = element_text(hjust = 0.5),
      axis.text.x = element_text(angle = 35, hjust = 1),
      panel.grid = element_blank()
    )
  
  ggsave(file_out, p, width = 10, height = 6.5, dpi = 320)
}

