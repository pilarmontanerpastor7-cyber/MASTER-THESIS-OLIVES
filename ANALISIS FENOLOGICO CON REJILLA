leer_rendimientos_excel <- function(rend_file) {
  sheets_xls <- readxl::excel_sheets(rend_file)
  
  detectar_tabla <- function(df) {
    if (is.null(df) || nrow(df) == 0 || ncol(df) < 3) return(NULL)
    df <- as.data.frame(df)
    df <- df[, colSums(!is.na(df)) > 0, drop = FALSE]
    if (ncol(df) < 3) return(NULL)
    
    nms_orig <- names(df)
    nms <- normalizar_texto(nms_orig)
    
    col_year <- which(grepl("annee|anio|ano|año|year|ejercicio", nms))[1]
    col_sec  <- which(grepl("secano", nms))[1]
    col_rie  <- which(grepl("riego|regadio", nms))[1]
    
    if (is.na(col_year) || is.na(col_sec) || is.na(col_rie)) {
      candidatos <- df[, 1:min(6, ncol(df)), drop = FALSE]
      score_year <- sapply(candidatos, function(z) {
        znum <- suppressWarnings(as.numeric(as.character(z)))
        sum(!is.na(znum) & znum >= 1900 & znum <= 2100)
      })
      if (max(score_year, na.rm = TRUE) >= 10) {
        col_year <- which.max(score_year)
        resto <- setdiff(seq_len(ncol(candidatos)), col_year)
        if (length(resto) >= 2) {
          col_sec <- resto[1]
          col_rie <- resto[2]
        }
      }
    }
    
    if (is.na(col_year) || is.na(col_sec) || is.na(col_rie)) return(NULL)
    
    out <- data.frame(
      year = suppressWarnings(as.numeric(df[[col_year]])),
      Qha_secano = limpiar_numerico(df[[col_sec]]),
      Qha_riego  = limpiar_numerico(df[[col_rie]])
    ) |>
      filter(!is.na(year)) |>
      filter(year >= 1900, year <= 2100) |>
      arrange(year) |>
      distinct(year, .keep_all = TRUE)
    
    if (nrow(out) < 10) return(NULL)
    if (sum(!is.na(out$Qha_secano)) == 0 && sum(!is.na(out$Qha_riego)) == 0) return(NULL)
    out
  }
  
  for (sh in sheets_xls) {
    for (sk in c(0, 1, 2, 3, 4, 5, 6, 8, 10, 12, 15, 20, 25, 30)) {
      tmp <- tryCatch(readxl::read_excel(rend_file, sheet = sh, skip = sk), error = function(e) NULL)
      out <- detectar_tabla(tmp)
      if (!is.null(out)) {
        message("Hoja usada para rendimientos: ", sh, " | skip = ", sk)
        return(out)
      }
    }
  }
  
  stop("No se pudo localizar una tabla válida de rendimientos.")
}

