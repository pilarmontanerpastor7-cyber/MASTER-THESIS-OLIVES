normalizar_texto <- function(x) {
  x <- as.character(x)
  x <- iconv(x, from = "", to = "ASCII//TRANSLIT")
  x <- tolower(trimws(x))
  x
}

limpiar_numerico <- function(x) {
  x <- as.character(x)
  x <- trimws(x)
  x <- gsub("\\u00A0", "", x)
  x <- gsub(" ", "", x)
  x <- gsub("\\.(?=\\d{3}(\\D|$))", "", x, perl = TRUE)
  x <- gsub(",", ".", x)
  x <- gsub("[^0-9\\.-]", "", x)
  suppressWarnings(as.numeric(x))
}

get_year_from_name <- function(path) {
  hits <- stringr::str_extract_all(basename(path), "(19|20)\\d{2}")[[1]]
  if (length(hits) == 0) return(NA_real_)
  as.numeric(hits[1])
}

safe_cor_test <- function(x, y) {
  sub <- data.frame(x = x, y = y) |> tidyr::drop_na()
  if (nrow(sub) < 5) {
    return(data.frame(n = nrow(sub), r = NA_real_, p = NA_real_))
  }
  if (sd(sub$x) == 0 || sd(sub$y) == 0) {
    return(data.frame(n = nrow(sub), r = NA_real_, p = NA_real_))
  }
  ct <- cor.test(sub$x, sub$y, method = "pearson")
  data.frame(
    n = nrow(sub),
    r = unname(ct$estimate),
    p = ct$p.value
  )
}

fase_fenologica <- function(month) {
  dplyr::case_when(
    month %in% c(1, 2) ~ "Reposo",
    month %in% c(3, 4) ~ "Brotacion",
    month == 5 ~ "Floracion",
    month == 6 ~ "Cuajado",
    month %in% c(7, 8, 9) ~ "Engorde",
    month %in% c(10, 11) ~ "Maduracion",
    month == 12 ~ "Recoleccion",
    TRUE ~ NA_character_
  )
}

