# =========================
calcular_correlaciones_grid <- function(df, response, vars_clima) {
  df |>
    group_by(cell_id, fase) |>
    group_modify(~{
      bind_rows(lapply(vars_clima, function(v) {
        res <- safe_cor_test(.x[[response]], .x[[v]])
        data.frame(
          respuesta = response,
          variable = v,
          n = res$n,
          r = res$r,
          p = res$p
        )
      }))
    }) |>
    ungroup()
}

cor_secano_grid <- calcular_correlaciones_grid(datos_fase, "Qha_secano", vars_clima)
cor_riego_grid  <- calcular_correlaciones_grid(datos_fase, "Qha_riego", vars_clima)

cor_grid_total <- bind_rows(cor_secano_grid, cor_riego_grid) |>
  mutate(
    significacion = case_when(
      is.na(p) ~ NA_character_,
      p < 0.001 ~ "***",
      p < 0.01 ~ "**",
      p < 0.05 ~ "*",
      TRUE ~ "ns"
    )
  )

