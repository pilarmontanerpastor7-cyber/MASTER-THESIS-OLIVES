# =========================
# 6. CONTROL DE ESCALA Y PLAUSIBILIDAD
# =========================
corregir_raster_variable <- function(r, varname) {
  test_val <- tryCatch(
    as.numeric(terra::global(terra::mean(r, na.rm = TRUE), "mean", na.rm = TRUE)[1, 1]),
    error = function(e) NA_real_
  )
  
  # TerraClimate temperatura a veces viene en décimas
  if (varname %in% c("TMAX", "TMIN")) {
    if (!is.na(test_val) && test_val > -5 && test_val < 5) {
      r <- r * 10
    }
  }
  
  # VPD puede venir escalado según fuente
  if (varname == "VPD") {
    if (!is.na(test_val) && test_val > 20) {
      r <- r / 100
    } else if (!is.na(test_val) && test_val > 10) {
      r <- r / 10
    }
  }
  
  # WSPEED puede venir escalado según fuente
  if (varname == "WSPEED") {
    if (!is.na(test_val) && test_val > 100) {
      r <- r / 100
    } else if (!is.na(test_val) && test_val > 30) {
      r <- r / 10
    }
  }
  
  # Rango plausible, valores fuera se ponen NA
  if (varname == "PPT") {
    r[r < 0 | r > 1000] <- NA
  }
  if (varname == "TMAX") {
    r[r < -5 | r > 50] <- NA
  }
  if (varname == "TMIN") {
    r[r < -20 | r > 35] <- NA
  }
  if (varname == "PET") {
    r[r < 0 | r > 500] <- NA
  }
  if (varname == "PDSI") {
    r[r < -10 | r > 10] <- NA
  }
  if (varname == "VPD") {
    r[r < 0 | r > 10] <- NA
  }
  if (varname == "WSPEED") {
    r[r < 0 | r > 40] <- NA
  }
  
  r
}

# =========================
# 7. EXTRAER VARIABLE MENSUAL A REJILLA
# =========================
extraer_variable_mensual_grid <- function(files, varname, grid_sf, jaen_vect) {
  message("Extrayendo variable: ", varname)
  
  out_list <- vector("list", length(files))
  
  for (i in seq_along(files)) {
    f <- files[i]
    year <- get_year_from_name(f)
    
    if (is.na(year)) {
      warning("No se pudo extraer año de: ", basename(f))
      next
    }
    
    r <- tryCatch(terra::rast(f), error = function(e) NULL)
    if (is.null(r)) {
      warning("No se pudo abrir: ", basename(f))
      next
    }
    
    r <- corregir_raster_variable(r, varname)
    
    # TerraClimate anual suele tener 12 capas mensuales.
    # Si solo hay 1 capa, se asume valor anual y se asigna a month = NA.
    nly <- terra::nlyr(r)
    
    if (nly >= 12) {
      meses <- seq_len(12)
      r <- r[[1:12]]
    } else {
      meses <- NA_integer_
    }
    
    # Transformar shapefile al CRS del raster si es necesario
    grid_r <- grid_sf
    if (sf::st_crs(grid_r) != sf::st_crs(terra::crs(r))) {
      grid_r <- sf::st_transform(grid_r, terra::crs(r))
    }
    
    jaen_r <- terra::project(jaen_vect, terra::crs(r))
    
    r <- terra::crop(r, jaen_r)
    r <- terra::mask(r, jaen_r)
    
    if (length(meses) == 12) {
      vals_all <- lapply(seq_along(meses), function(j) {
        rr <- r[[j]]
        vals <- exactextractr::exact_extract(raster::raster(rr), grid_r, "mean")
        data.frame(
          cell_id = grid_sf$cell_id,
          year = year,
          month = meses[j],
          value = vals
        )
      })
      
      out_list[[i]] <- bind_rows(vals_all)
    } else {
      vals <- exactextractr::exact_extract(raster::raster(r), grid_r, "mean")
      out_list[[i]] <- data.frame(
        cell_id = grid_sf$cell_id,
        year = year,
        month = NA_integer_,
        value = vals
      )
    }
    
    gc()
  }
  
  out <- bind_rows(out_list)
  names(out)[names(out) == "value"] <- varname
  out
}

