# 9. STEPWISE + LOOCV


loocv_lm <- function(formula, data) {
  n <- nrow(data)
  pred <- rep(NA_real_, n)
  
  for (i in seq_len(n)) {
    train <- data[-i, , drop = FALSE]
    test  <- data[i, , drop = FALSE]
    mod <- tryCatch(lm(formula, data = train), error = function(e) NULL)
    if (!is.null(mod)) {
      pred[i] <- tryCatch(predict(mod, newdata = test), error = function(e) NA_real_)
    }
  }
  
  obs <- model.response(model.frame(formula, data))
  
  data.frame(
    RMSE_LOOCV = sqrt(mean((obs - pred)^2, na.rm = TRUE)),
    MAE_LOOCV = mean(abs(obs - pred), na.rm = TRUE)
  )
}

hacer_stepwise <- function(df, respuesta, top_n = 12) {
  preds <- setdiff(names(df), c("year", "Qha_secano", "Qha_riego"))
  
  cors <- data.frame(
    predictor = preds,
    r = sapply(preds, function(p) {
      if (sum(complete.cases(df[[respuesta]], df[[p]])) < 10) return(NA_real_)
      cor(df[[respuesta]], df[[p]], use = "complete.obs")
    })
  ) |>
    filter(!is.na(r)) |>
    mutate(abs_r = abs(r)) |>
    arrange(desc(abs_r)) |>
    slice_head(n = top_n)
  
  vars <- cors$predictor
  
  df_mod <- df |>
    dplyr::select(all_of(c("year", respuesta, vars))) |>
    drop_na()
  
  mod0 <- lm(as.formula(paste(respuesta, "~ 1")), data = df_mod)
  mod_full <- lm(as.formula(paste(respuesta, "~", paste(vars, collapse = " + "))), data = df_mod)
  
  mod_step <- stepAIC(
    mod0,
    scope = list(lower = mod0, upper = mod_full),
    direction = "both",
    trace = FALSE
  )
  
  obs <- model.response(model.frame(mod_step))
  pred <- predict(mod_step)
  fstat <- summary(mod_step)$fstatistic
  loocv <- loocv_lm(formula(mod_step), model.frame(mod_step))
  
  metricas <- data.frame(
    modelo = respuesta,
    R2 = summary(mod_step)$r.squared,
    R2_ajustado = summary(mod_step)$adj.r.squared,
    RMSE = sqrt(mean((obs - pred)^2, na.rm = TRUE)),
    MAE = mean(abs(obs - pred), na.rm = TRUE),
    AIC = AIC(mod_step),
    F = unname(fstat[1]),
    p_value = pf(fstat[1], fstat[2], fstat[3], lower.tail = FALSE),
    RMSE_LOOCV = loocv$RMSE_LOOCV,
    MAE_LOOCV = loocv$MAE_LOOCV,
    formula = paste(deparse(formula(mod_step)), collapse = " ")
  )
  
  list(modelo = mod_step, datos = df_mod, preseleccion = cors, metricas = metricas)
}

