getv <- function(df, var, months, fun = "mean") {
  vals <- df |> filter(variable == var, month %in% months) |> pull(value)
  if (length(vals) == 0 || all(is.na(vals))) return(NA_real_)
  if (fun == "sum") sum(vals, na.rm = TRUE) else mean(vals, na.rm = TRUE)
}

crear_vars_year <- function(y) {
  actual <- datos_mensuales |> filter(year == y)
  prev   <- datos_mensuales |> filter(year == y - 1)
  
  vars <- c("PPT", "TMAX", "TMIN", "PET", "PDSI", "VPD", "WSPEED", "NDVI", "EVI")
  sum_vars <- c("PPT", "PET")
  
  fases <- list(
    Reposo = c(1, 2),
    Brotacion = c(3, 4),
    Floracion_Cuajado = c(5, 6),
    Engorde = c(7, 8, 9),
    Maduracion = c(10, 11),
    Recoleccion = c(12)
  )
  
  out <- data.frame(year = y)
  
  for (v in vars) {
    fun <- ifelse(v %in% sum_vars, "sum", "mean")
    
    for (fase in names(fases)) {
      out[[paste(v, fase, sep = "_")]] <- getv(actual, v, fases[[fase]], fun)
    }
    
    out[[paste0(v, "_annual")]] <- getv(actual, v, 1:12, fun)
    out[[paste0(v, "_MAM")]] <- getv(actual, v, 3:5, fun)
    out[[paste0(v, "_JJA")]] <- getv(actual, v, 6:8, fun)
    out[[paste0(v, "_SON")]] <- getv(actual, v, 9:11, fun)
    
    out[[paste0(v, "_hydro")]] <- if (fun == "sum") {
      sum(getv(prev, v, 9:12, fun), getv(actual, v, 1:8, fun), na.rm = TRUE)
    } else {
      mean(c(getv(prev, v, 9:12, fun), getv(actual, v, 1:8, fun)), na.rm = TRUE)
    }
    
    out[[paste0(v, "_physio")]] <- if (fun == "sum") {
      sum(getv(prev, v, 9:12, fun), getv(actual, v, 1:12, fun), na.rm = TRUE)
    } else {
      mean(c(getv(prev, v, 9:12, fun), getv(actual, v, 1:12, fun)), na.rm = TRUE)
    }
  }
  
  out
}

