# 2. FUNCIONES


limpiar_num <- function(x) {
  x <- as.character(x)
  x <- gsub("\\u00A0| ", "", x)
  x <- gsub("\\.(?=\\d{3}(\\D|$))", "", x, perl = TRUE)
  x <- gsub(",", ".", x)
  x <- gsub("[^0-9\\.-]", "", x)
  suppressWarnings(as.numeric(x))
}

get_year <- function(x) {
  suppressWarnings(as.numeric(str_extract(basename(x), "(19|20)\\d{2}")))
}

get_date_modis <- function(path) {
  x <- basename(path)
  hit <- str_extract(x, "A(19|20)\\d{2}\\d{3}")
  if (!is.na(hit)) {
    year <- as.numeric(substr(hit, 2, 5))
    doy  <- as.numeric(substr(hit, 6, 8))
    return(as.Date(doy - 1, origin = paste0(year, "-01-01")))
  }
  d <- str_extract(x, "(19|20)\\d{2}[-_]\\d{2}[-_]\\d{2}")
  if (!is.na(d)) return(as.Date(gsub("_", "-", d)))
  y <- get_year(path)
  if (is.na(y)) return(as.Date(NA))
  as.Date(paste0(y, "-01-01"))
}

find_files <- function(path, key = NULL) {
  if (!dir.exists(path)) {
    warning("No existe la carpeta: ", path)
    return(character(0))
  }
  x <- list.files(
    path,
    pattern = "\\.(tif|tiff|nc|gpkg)$",
    full.names = TRUE,
    recursive = TRUE,
    ignore.case = TRUE
  )
  x <- x[!grepl("^\\._|\\.DS_Store|-wal|-shm", basename(x))]
  if (!is.null(key)) {
    y <- x[str_detect(tolower(basename(x)), tolower(key))]
    if (length(y) > 0) x <- y
  }
  sort(x)
}

fase_from_month <- function(m) {
  case_when(
    m %in% c(1, 2) ~ "Reposo",
    m %in% c(3, 4) ~ "Brotacion",
    m %in% c(5, 6) ~ "Floracion_Cuajado",
    m %in% c(7, 8, 9) ~ "Engorde",
    m %in% c(10, 11) ~ "Maduracion",
    m == 12 ~ "Recoleccion",
    TRUE ~ NA_character_
  )
}

media_jaen <- function(r, jaen_sf) {
  jaen_v <- vect(st_transform(jaen_sf, crs(r)))
  r2 <- crop(r, jaen_v)
  r3 <- mask(r2, jaen_v)
  as.numeric(global(r3, "mean", na.rm = TRUE)[1, 1])
}

corregir_valor <- function(valor, var) {
  if (is.na(valor)) return(NA_real_)
  
  if (var %in% c("TMAX", "TMIN") && abs(valor) > 80) valor <- valor / 10
  if (var %in% c("NDVI", "EVI") && abs(valor) > 2) valor <- valor / 10000
  if (var == "VPD" && valor > 20) valor <- valor / 100
  if (var == "VPD" && valor > 10 && valor <= 20) valor <- valor / 10
  if (var == "WSPEED" && valor > 100) valor <- valor / 100
  if (var == "WSPEED" && valor > 30 && valor <= 100) valor <- valor / 10
  
  if (var == "PPT"    && (valor < 0 | valor > 1500)) return(NA_real_)
  if (var == "TMAX"   && (valor < 0 | valor > 50)) return(NA_real_)
  if (var == "TMIN"   && (valor < -15 | valor > 35)) return(NA_real_)
  if (var == "PET"    && (valor < 0 | valor > 500)) return(NA_real_)
  if (var == "PDSI"   && (valor < -10 | valor > 10)) return(NA_real_)
  if (var == "VPD"    && (valor < 0 | valor > 10)) return(NA_real_)
  if (var == "WSPEED" && (valor < 0 | valor > 40)) return(NA_real_)
  if (var == "NDVI"   && (valor < -1 | valor > 1)) return(NA_real_)
  if (var == "EVI"    && (valor < -1 | valor > 1)) return(NA_real_)
  
  valor
}


