elegir_mascara <- function(year) {
  disponibles <- tabla_masks |> filter(year_mask <= year)
  if (nrow(disponibles) == 0) return(NA_character_)
  disponibles$ruta[which.max(disponibles$year_mask)]
}

media_modis_olivar <- function(r, mask_path) {
  jaen_v <- vect(st_transform(jaen, crs(r)))
  r <- crop(r, jaen_v)
  r <- mask(r, jaen_v)
  
  if (grepl("\\.gpkg$", mask_path, ignore.case = TRUE)) {
    shp <- st_read(mask_path, quiet = TRUE)
    shp <- st_make_valid(shp)
    shp <- st_transform(shp, st_crs(jaen))
    shp <- suppressWarnings(st_intersection(shp, jaen))
    
    shp_v <- vect(st_transform(shp, crs(r)))
    r2 <- crop(r, shp_v)
    r3 <- mask(r2, shp_v)
    
    return(as.numeric(global(r3, "mean", na.rm = TRUE)[1, 1]))
  }
  
  if (grepl("\\.tif$|\\.tiff$", mask_path, ignore.case = TRUE)) {
    m <- rast(mask_path)
    
    if (!same.crs(m, r)) {
      m <- project(m, r, method = "near")
    }
    
    if (!compareGeom(r, m, stopOnError = FALSE)) {
      m <- resample(m, r, method = "near")
    }
    
    m_bin <- m > 0
    r_mask <- mask(r, m_bin, maskvalues = 0)
    
    return(as.numeric(global(r_mask, "mean", na.rm = TRUE)[1, 1]))
  }
  
  NA_real_
}


