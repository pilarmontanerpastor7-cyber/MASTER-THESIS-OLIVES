# 4. CLIMA TERRACLIMATE


extraer_clima_mensual <- function(files, varname) {
  out <- list()
  k <- 1
  
  for (f in files) {
    year <- get_year(f)
    if (is.na(year) || year < 1999 || year > 2025) next
    
    message("CLIMA ", varname, " | ", year)
    
    r <- tryCatch(rast(f), error = function(e) NULL)
    if (is.null(r) || nlyr(r) < 12) next
    
    for (m in 1:12) {
      val <- tryCatch(media_jaen(r[[m]], jaen), error = function(e) NA_real_)
      val <- corregir_valor(val, varname)
      
      out[[k]] <- data.frame(
        year = year,
        month = m,
        variable = varname,
        value = val
      )
      k <- k + 1
    }
    
    rm(r)
    gc()
  }
  
  bind_rows(out)
}

