extraer_vi_16dias <- function(files, varname) {
  out <- list()
  k <- 1
  
  for (f in files) {
    fecha <- get_date_modis(f)
    if (is.na(fecha)) next
    
    year <- as.numeric(format(fecha, "%Y"))
    month <- as.numeric(format(fecha, "%m"))
    fase <- fase_from_month(month)
    
    if (year < 2000 || year > 2025) next
    
    mask_path <- elegir_mascara(year)
    if (is.na(mask_path)) next
    
    message("VI ", varname, " | ", fecha, " | ", basename(mask_path))
    
    r <- tryCatch(rast(f), error = function(e) NULL)
    if (is.null(r)) next
    
    r <- r[[1]]
    
    val <- tryCatch(media_modis_olivar(r, mask_path), error = function(e) NA_real_)
    val <- corregir_valor(val, varname)
    
    out[[k]] <- data.frame(
      year = year,
      month = month,
      fase = fase,
      variable = varname,
      value = val,
      mascara = basename(mask_path)
    )
    
    k <- k + 1
    
    rm(r)
    gc()
  }
  
  bind_rows(out)
}

